# ra-signatures configuration
#
# Copy this file to .env and fill in real values:
#   cp .env.example .env && chmod 600 .env
# .env is gitignored; never commit it. The app refuses to start if either
# value below is missing.

# Your RetroAchievements username.
RA_API_USERNAME=

# Your RetroAchievements Web API key (from your account settings on
# retroachievements.org). Treat it like a password.
RA_API_KEY=
